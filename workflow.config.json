{
  "confirm": {
    "prepare": true,
    "draft": true,
    "tts": true,
    "visual_plan": true,
    "assets": true,
    "video": true
  },
  "retain": {
    "chat_log": true,
    "draft": true,
    "audio": true,
    "subtitle": true
  },
  "llm": {
    "base_url": "https://api.openai.com/v1",
    "api_key_env": "OPENAI_API_KEY",
    "model": "gpt-4o-mini"
  },
  "templates": {
    "root": "templates"
  },
  "visual_plan": {
    "script": "scripts/generate_visual_plan.py",
    "default_category": "general"
  },
  "visual_assets": {
    "script": "scripts/build_visual_assets.py",
    "config": "scripts/visual_assets.config.json",
    "manifest_name": "asset-manifest.json"
  },
  "jimeng": {
    "client_config": "scripts/jimeng_visual.config.json",
    "image_script": "scripts/jimeng_generate_image.py",
    "video_script": "scripts/jimeng_generate_video.py"
  },
  "tts": {
    "script": "scripts/volc_tts_ws.py",
    "clone_script": "scripts/volc_clone_voice.py",
    "voice_source_mode": "existing_speaker",
    "config": "scripts/volc_tts_ws.config.json",
    "output_format": "mp3"
  },
  "subtitle": {
    "script": "scripts/align_subtitles_with_whisper.py",
    "config": "scripts/whisper_batch_transcribe.config.json"
  },
  "subtitle_sync": {
    "enabled": true,
    "min_exact_match_coverage": 0.92,
    "max_character_error_rate": 0.18,
    "min_timing_coverage": 0.98,
    "max_boundary_drift_ms": 700,
    "max_unresolved_span_ms": 2000,
    "min_block_confidence": 0.35,
    "max_tts_regeneration_per_segment": 1
  },
  "projects": {
    "root": "projects"
  },
  "library": {
    "style_default_dir": "library/style/default",
    "voice_default_file": "library/voice/default/voice.mp3"
  },
  "renderer": {
    "engine": "remotion",
    "project_dir": "renderer",
    "composition_id": "NarratedVideo",
    "width": 1920,
    "height": 1080,
    "fps": 25,
    "codec": "h264",
    "generation_enabled": false
  }
}
